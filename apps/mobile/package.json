{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "deps:check": "expo install --check",
    "test": "npm run test:reader && npm run test:popover && npm run test:highlight-guide && npm run test:sheet-gesture && npm run test:ocr && npm run test:camera-frame && npm run test:save && npm run test:library && npm run test:latency && npm run test:feedback && npm run test:error-hardening",
    "validate": "npm run typecheck && npm test && npm run deps:check",
    "test:reader": "tsx src/features/reader/renderAnnotatedText.test.ts",
    "test:popover": "tsx src/features/reader/getPopoverLayout.test.ts",
    "test:highlight-guide": "tsx src/features/reader/highlightGuideStorage.test.ts",
    "test:sheet-gesture": "tsx src/features/reader/referenceSheetGesture.test.ts",
    "test:ocr": "tsx src/services/ocr/normalize.test.ts && tsx src/services/ocr/timeout.test.ts",
    "test:camera-frame": "tsx src/features/scan/captureFrameLogic.test.ts",
    "test:save": "tsx src/services/supabase/saveNoteLogic.test.ts",
    "test:library": "tsx src/services/supabase/libraryLogic.test.ts",
    "test:latency": "tsx src/stores/latencyLogic.test.ts",
    "test:feedback": "tsx src/services/supabase/feedbackLogic.test.ts",
    "test:error-hardening": "tsx src/services/api/network.test.ts && tsx src/stores/analyzeErrorLogic.test.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/native-stack": "^7.14.6",
    "@supabase/supabase-js": "^2.106.2",
    "expo": "~57.0.25",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-text-extractor": "^2.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
